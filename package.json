{
  "name": "hrms-frontend",
  "version": "1.1.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json && npm run lint:eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:mock": "playwright test -c playwright.mock.config.ts",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "e2e:stack": "node e2e/full/stack.mjs up --reset",
    "lint:eslint": "test -d tools/lint/node_modules || npm --prefix tools/lint ci --no-audit --no-fund; tools/lint/node_modules/.bin/eslint -c tools/lint/eslint.config.mjs src e2e scripts --max-warnings 0",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle.mjs",
    "e2e:visual": "E2E_TODAY=2026-11-05 playwright test -c playwright.mock.config.ts e2e/mock/visual.mock.ts"
  },
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "private": true,
  "dependencies": {
    "@tanstack/react-query": "^5.106.0",
    "lucide-react": "^1.68.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "description": "HRMS web app (React + Vite)",
  "engines": {
    "node": ">=22"
  }
}
