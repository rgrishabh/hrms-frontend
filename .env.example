# Runtime variables read by the container at start (docker/40-hrms-runtime.sh). NOT secrets:
# they end up in index.html / env.js / the manifest, which every visitor can read. Never put secrets here.
# The full configuration is served by the backend (GET /api/v1/config/public); in Compose the
# frontend gets these from the same .brandenv so first paint and the PWA manifest match.
APP_ENVIRONMENT=dev            # "production" hides the environment badge
BRAND_NAME=Example Laboratories
BRAND_PRODUCT_NAME=Example HRMS
BRAND_PRIMARY_COLOR=#14532D    # #rgb or #rrggbb
BRAND_FAVICON_URL=             # https://… or /brand/<file> (served by the backend)
BRAND_LOGO_URL=                # only used to allow an external logo origin in the CSP
BRAND_LOGO_DARK_URL=           # same
HSTS=true
# APP_VERSION is baked into the image at build time.
