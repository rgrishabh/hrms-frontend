# Runtime variables read by the container at start (docker/40-hrms-runtime.sh). NOT secrets:
# they end up in index.html / env.js, which every visitor can read. Never put secrets here.
# The full branding/runtime configuration is served by the backend (/api/v1/public/config);
# these only make the first paint (title, theme colour, favicon) and the env badge correct.
APP_ENVIRONMENT=dev            # "production" hides the environment badge
PRODUCT_NAME=HRMS
BRAND_SHORT_NAME=HRMS
BRAND_PRIMARY_COLOR=#1f4e79    # #rgb or #rrggbb
BRAND_FAVICON_URL=             # https://… or /branding/<file> (served by the backend)
BRAND_LOGO_URL=                # only used to allow an external logo origin in the CSP
HSTS=true
# APP_VERSION is baked into the image at build time.
